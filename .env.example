# 复制本文件为 .env 并填入你的密钥（.env 会被 config.py 自动加载）

# OpenAI 兼容后端（默认，推荐）—— 以智谱 GLM 为例
MINICLAUDE_PROVIDER=openai
MINICLAUDE_MODEL=glm-4-flash
MINICLAUDE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MINICLAUDE_API_KEY=你的GLM-API-KEY

# 也可用通用别名
# OPENAI_API_KEY=sk-xxx
# ANTHROPIC_API_KEY=sk-ant-xxx

# 权限模式（default/plan/acceptEdits/bypassPermissions/dontAsk）
# MINICLAUDE_PERMISSION_MODE=default

# 上下文窗口 token 数
# MINICLAUDE_CONTEXT_WINDOW=128000

# 语义检索嵌入模型（可选）：不填则用零成本词元嵌入；填了走智谱 embedding-2 稠密向量
# 注意 embedding-2 为计费模型，需在智谱平台购买额度
# MINICLAUDE_EMBEDDING_MODEL=embedding-2
